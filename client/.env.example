# ==============================================================================
# CarrerSync Client Environment Configuration
# Strict ₹0 Zero-Cost Architecture | Cardless Deployment
# Copy this file to client/.env (or client/.env.local) and configure values.
#
# IMPORTANT:
# Only variables prefixed with VITE_ are embedded into the client bundle by Vite.
# NEVER store backend secret keys, database credentials, or private tokens here.
# ==============================================================================

# API Base URL
# Development: /api/v1 (proxied to backend by Vite) or http://localhost:5050/api/v1
# Production on Vercel: /api/v1 (rewritten to Render API) or https://carrersync-api.onrender.com/api/v1
VITE_API_URL=/api/v1

# Realtime WebSocket URL
# Development: ws://localhost:5050/ws
# Production: wss://carrersync-api.onrender.com/ws
VITE_WS_URL=ws://localhost:5050/ws

# Vite Dev Server Proxy Target (used by vite.config.js to proxy /api requests)
VITE_API_PROXY_TARGET=http://localhost:5050
