# ==============================================================================
# CarrerSync Node.js + Express 5 Server Environment Configuration
# Strict ₹0 Zero-Cost Architecture | Cardless Deployment
# Copy this file to server/.env (or server/.env.local) and configure values.
# NEVER COMMIT .env OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Core Application Settings
PORT=5050
NODE_ENV=development
ENVIRONMENT=development
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://carrersync.vercel.app

# Database (Neon PostgreSQL Serverless Free Tier)
# Use pooled connection string for app queries; unpooled for schema migrations
DATABASE_URL=postgresql://<user>:<password>@<neon-endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<neon-endpoint-direct>.neon.tech/neondb?sslmode=require

# Security & Authentication
# Minimum 32-character high-entropy cryptographic secret for signing JWT tokens
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7200

# AI Provider (Google Gemini API Free Tier - Cardless)
# Optional: deterministic rule-based AI engine is active by default if key is not set
GEMINI_API_KEY=

# Provider-Independent File Storage Subsystem
# Options: 'local' (local disk storage) | 's3' (S3-compatible / Neon Object Storage)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=uploads

# S3-Compatible Cloud Storage Configuration (Required only when STORAGE_PROVIDER=s3)
STORAGE_BUCKET=carrersync-documents
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
