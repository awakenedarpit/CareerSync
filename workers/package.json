{
  "name": "carrersync-workers",
  "version": "1.0.0",
  "description": "CarrerSync Cloudflare Workers Multi-Tenant Backend with Hono, Drizzle, and Neon PostgreSQL",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
