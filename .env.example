# ==========================================
# CarrerSync Environment Configuration Example
# Strict ₹0 Zero-Cost Architecture
# Copy this file to .env and configure values.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==========================================

# -----------------
# DATABASE CONFIG (Neon PostgreSQL Free Tier via asyncpg)
# Required for backend database layer, Alembic migrations, and repositories.
# -----------------
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-endpoint>.neon.tech/carrersync?sslmode=require

# Connection Pooling (Conservative defaults for Neon Free Tier)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_ECHO=false

# -----------------
# AUTHENTICATION & SECURITY
# -----------------
SECRET_KEY=your_super_secret_jwt_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# -----------------
# APPLICATION CONFIG
# -----------------
ENVIRONMENT=development
PORT=5000
CLIENT_URL=http://localhost:5173

# -----------------
# AI STRATEGY (Google Gemini API Free Tier)
# Optional; platform seamlessly falls back to deterministic rule engines.
# -----------------
GEMINI_API_KEY=

# -----------------
# STORAGE (Cloudflare R2 Private Bucket)
# Optional during initial development; schema maps private keys directly.
# -----------------
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# -----------------
# FRONTEND CONFIG
# -----------------
VITE_API_URL=http://localhost:5000/api
