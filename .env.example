# ==============================================================================
# CarrerSync Master Environment Configuration Template
# Strict ₹0 Zero-Cost Architecture | Cardless Deployment
# Copy this file to .env (or .env.local) and configure your values.
# NEVER COMMIT .env OR SECRET FILES TO VERSION CONTROL.
# ==============================================================================

# ==============================================================================
# 1. BACKEND CONFIGURATION (Node.js + Express 5 Server)
# ==============================================================================

# Core Application Settings
PORT=5050
NODE_ENV=development
ENVIRONMENT=development
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://carrersync.vercel.app

# Database (Neon PostgreSQL Serverless Free Tier)
# Use pooled endpoint for standard application queries; unpooled for Drizzle migrations
DATABASE_URL=postgresql://<user>:<password>@<neon-endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<neon-endpoint-direct>.neon.tech/neondb?sslmode=require

# Authentication & Security
# Cryptographically secure random key (at least 32 characters) for JWT signing
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7200

# AI Provider (Google Gemini API Free Tier - Cardless)
# Optional: platform seamlessly falls back to deterministic rule-based engines if omitted
GEMINI_API_KEY=

# Provider-Independent File Storage Subsystem
# Options: 'local' (local disk storage) | 's3' (Neon Object Storage / Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=uploads

# S3-Compatible Storage Settings (Required only when STORAGE_PROVIDER=s3)
STORAGE_BUCKET=carrersync-documents
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ==============================================================================
# 2. FRONTEND CONFIGURATION (React 19 + TypeScript + Vite)
# Note: Only variables with VITE_ prefix are exposed to client browser bundles.
# NEVER place backend secrets or private credentials in VITE_ variables!
# ==============================================================================

# API Base URL
# Development: /api/v1 (proxied via Vite) or http://localhost:5050/api/v1
# Production: /api/v1 (rewritten via vercel.json) or https://carrersync-api.onrender.com/api/v1
VITE_API_URL=/api/v1

# Realtime WebSocket URL
# Development: ws://localhost:5050/ws
# Production: wss://carrersync-api.onrender.com/ws
VITE_WS_URL=ws://localhost:5050/ws

# Vite Dev Server Proxy Target
VITE_API_PROXY_TARGET=http://localhost:5050
