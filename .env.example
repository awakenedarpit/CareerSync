# ==============================================================================
# CarrerSync Master Environment Configuration Example
# Strict ₹0 Zero-Cost Architecture | Cardless Deployment
# Copy this file to .env and configure values.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# -----------------
# DATABASE CONFIG (Neon PostgreSQL Free Tier)
# Supports both Node.js (postgresql://) and Python asyncpg (postgresql+asyncpg://)
# -----------------
DATABASE_URL=postgresql://<user>:<password>@<neon-endpoint>.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<neon-endpoint-direct>.neon.tech/neondb?sslmode=require

# Connection Pooling (Conservative defaults for Neon Free Tier)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_ECHO=false

# -----------------
# AUTHENTICATION & SECURITY
# -----------------
SECRET_KEY=your_super_secret_jwt_key_at_least_32_chars_long
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_EXPIRES_IN=7200

# -----------------
# APPLICATION CONFIG
# -----------------
ENVIRONMENT=development
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# -----------------
# AI STRATEGY (Google Gemini API Free Tier)
# Optional; platform seamlessly falls back to deterministic rule engines.
# -----------------
GEMINI_API_KEY=

# -----------------
# PROVIDER-INDEPENDENT FILE STORAGE SUBSYSTEM
# Options: 'local' (development/test) | 's3' (production: Neon Object Storage / MinIO)
# -----------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIRECTORY=uploads
STORAGE_BUCKET=carrersync-documents
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# -----------------
# FRONTEND CONFIG
# -----------------
VITE_API_URL=http://localhost:5000/api
